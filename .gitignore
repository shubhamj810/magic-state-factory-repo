__pycache__/
*.pyc
.venv/
.DS_Store

# Row-space audit shards: large and reproducible from classify_rowspace.py
# (see classification/legacy/exhaustive_n38/docs/SHARDING.md); only the merged
# catalogue is kept.
classification/legacy/exhaustive_n38/results/shards/

# A capped symmetry_groups.py run writes its partial result beside the catalogue
# under this name rather than replacing it; it is diagnostic output, not a table.
symmetry_sat_search/catalog/*.incomplete.json

# Scratch output from exploratory runs. Curated/certificate inputs are checked
# in under stable names; local solver output stays out of the repository.
classification/legacy/rank7_census/results/*.tmp
classification/legacy/rank7_census/results/census_*.json
parent_first/results/
symmetry_sat_search/results/*
!symmetry_sat_search/results/README.md


# The autonomous loop's own stdout, written beside the (now removed) refactor
# scaffolding it drove. Harness output, not repository content.
master_catalog/REFACTOR/

# The length-48 catalogue is shipped gzipped (136 MB raw, over GitHub's file limit);
# a local gunzip of it must not be committed.
classification/legacy/n48/length48_catalogue.json

# The built website: generated from master_catalog.json by website/build_site.py,
# and rebuilt by the Pages workflow on every deploy.
website/_site/
